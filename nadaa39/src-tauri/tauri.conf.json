{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nadaa",
  "version": "0.1.0",
  "identifier": "com.ramatema.nadaa39",
  "build": {
    "beforeDevCommand": "npm --prefix apps/web run dev",
    "beforeBuildCommand": "npm --prefix apps/web run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nadaa — MPI",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "resources/icon.png"
    ]
  }
}
